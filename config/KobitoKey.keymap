#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y     &kp U       &kp I           &kp O      &kp P
&kp A        &kp S        &kp D        &kp F        &kp G        &kp H     &kp J       &kp K           &kp L      &mt ENTER LALT
&kp Z        &kp X        &kp C        &kp V        &kp B        &kp N     &kp M       &kp COMMA       &kp DOT    &kp SLASH
&kp K_VOL_DN &kp K_VOL_UP &mt LCMD ESC &lt 2 LANG1  &kp SPACE    &kp BSPC  &lt 3 LANG2 &mt RCTRL LANG2 &kp C_PREV &kp C_NEXT
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp N1     &kp N2     &kp N3     &kp N4     &kp N5        &kp N6          &kp N7      &kp N8       &kp N9        &kp N0
&kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)    &kp LEFT        &kp DOWN    &kp UP       &kp RIGHT     &kp SEMI
&kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)    &kp RS(RC(TAB)) &kp RC(TAB) &kp RC(LEFT) &kp RC(RIGHT) &kp BSLH
&trans     &trans     &trans     &mo 4      &trans        &kp DEL         &mo 4       &trans       &trans        &trans
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&kp F1  &kp F2  &kp F3    &kp F4    &kp F5       &kp F6   &kp F7   &kp F8   &kp F9    &kp F10
&kp SQT &kp DQT &kp GRAVE &kp MINUS &kp PLUS     &kp LBKT &kp RBKT &kp LBRC &kp RBRC  &kp COLON
&kp ESC &trans  &kp TILDE &kp UNDER &kp EQUAL    &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp BSLH
&trans  &trans  &trans    &mo 4     &trans       &kp DEL  &mo 4    &trans   &trans    &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1      &bt BT_SEL 2  &kp K_VOL_DN &kp K_VOL_UP    &kp C_AC_SCROLL_DOWN &kp C_AC_SCROLL_UP &trans   &trans &kp LG(BSPC)
&trans         &kp LG(RS(RC(3))) &kp LG(RS(3)) &mkp MB1     &mkp MB2        &trans               &trans             &trans   &trans &trans
&trans         &trans            &trans        &kp C_PREV   &kp C_NEXT      &mkp MB1             &mkp MB2           &mkp MB3 &trans &trans
&bt BT_CLR_ALL &bt BT_CLR_ALL    &trans        &trans       &kp C_PP        &mkp MB1             &mkp MB2           &mkp MB3 &trans &to 0
            >;
        };
    };
};
